  "$discover_comment": "发现层：GitHub Search 主动找仓库。mode=review 表示进候选队列等人工审，不直接上线。",
  "discover": {
    "enabled": true,
    "mode": "review",
    "queries": [
      "topic:claude-skills stars:>{minStars}",
      "topic:claude-code stars:>{minStars}",
      "topic:agent-skills stars:>{minStars}",
      "topic:ai-agents stars:>{minStars} pushed:>{daysAgo}",
      "topic:mcp-server stars:>{minStars} pushed:>{daysAgo}",
      "topic:skills pushed:>{daysAgo} stars:>{minStars}",
      "topic:claude-code-skills stars:>{minStars} pushed:>{daysAgo}",
      "topic:ai-coding-agent stars:>{minStars} pushed:>{daysAgo}",
      "topic:llm-agent stars:>{minStars} pushed:>{daysAgo}",
      "topic:agentic-ai stars:>{minStars} pushed:>{daysAgo}",
      "topic:cursor-rules stars:>{minStars} pushed:>{daysAgo}",
      "topic:prompt-engineering stars:>{minStars} pushed:>{daysAgo}"
    ],
    "codeQueries": [
      "filename:SKILL.md",
      "path:.claude-plugin filename:marketplace.json",
      "filename:SKILL.md path:skills",
      "filename:.clinerules",
      "filename:AGENTS.md path:.codex"
    ],
    "daysAgo": 180,
    "minStars": 30,
    "maxNewPerRun": 150,
    "queryPages": 2,
    "codeQueryPages": 2,
    "codeSearchPerRun": 30,
    "codeEnrichLimit": 400,
    "rejectRetryDays": 60
  },
  "$review_comment": "收录校验口径的唯一来源，add-repo.mjs 与 review-submission.mjs 共用。minStars 由 150 下调到 30：站点上线后反馈「收录太少、分类空」，150 星门槛把中小仓库整体排除；30 星仍能过滤掉空壳/测试仓库，配合 requireSkillFile + maxInactiveMonths 保持质量。descMaxLen=1500 的由来：文档原定 400，实测拒掉 anthropics/skills 自身 40% 的 skill（8/20）；Anthropic 规范声明 1024，但其官方 claude-api 实为 1068，故留 1500 余量。校验通过的超长描述在展示层截断，不在此处拒收。",
  "review": {
    "submissionsDir": "submissions",
    "candidatesDir": "crawler/candidates",
    "candidateBranch": "crawl/candidates",
    "minStars": 30,
    "requireSkillFile": true,
    "maxInactiveMonths": 24,
    "descMinLen": 20,
    "descMaxLen": 1500,
    "nameMaxLen": 64
  },
  "$limits_comment": "配额治理三护栏：requestBudget 主动刹车 / reserveQuota 保命预留 / refreshHours 必须 > cron 间隔(12h)。concurrency 只作用于取正文（raw 走 CDN 不计配额，可并发）。",
  "limits": {
    "maxSkillsPerRepo": 50,
    "requestDelayMs": 120,
    "concurrency": 5,
    "minRemainingQuota": 40,
    "requestBudget": 4200,
    "reserveQuota": 250,
    "refreshHours": 20,
    "maxWaitMin": 15,
    "timeoutMs": 20000,
    "treeTimeoutMs": 60000,
    "rawTimeoutMs": 6000,
    "rawFailThreshold": 2,
    "retries": 3
  },
  "$prerender_comment": "预渲染门槛与硬闸门。maxPages 必须 < 平台单次部署 20000 文件上限。requireZhSummary=false 的理由：中文摘要流水线（LLM 生成 + 人工抽审）尚未上线，若坚持「有自写摘要才建独立页」，首版站点 0 个 skill 详情页、SEO 全空。先放开用英文原文建页并在页面标注「原文」，摘要上线后改回 true。",
  "prerender": {
    "independentPageScore": 5,
    "requireZhSummary": false,
    "maxPages": 18000,
    "sitemapChunkSize": 5000,
    "llmsMaxLines": 300,
    "llmsPerCategory": 30
  },
  "$category_comment": "用途分类：一条记录 = { 分类: [关键词...] }。命中数最多者胜出（不是先命中先归属——否则「编码」会吃掉一切）。未分类占比 > 20% 必须回头补规则。2026-10 由 8 类扩到 13 类（新增办公/媒体/营销/安全/学习）：原八类把会议纪要、音视频、SEO、漏洞审计、教学类内容全塞进「编码/生活」，用户反馈用途划分太少。",
  "$categoryWeights_comment": "分类权重：score = 命中数 × 权重，默认 1。编码类的关键词（code/test/api/git…）在所有技术仓库里都高频出现，纯计数会压过领域类，故降权让它「遇到明确领域词就让位」。",
  "categoryWeights": {
    "编码": 0.75
  },
